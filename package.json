{
  "name": "dsh-dynamic-multiagent",
  "version": "0.2.0",
  "description": "Dynamic multi-agent orchestration plugin for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./core/*": "./src/core/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "config",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6 <0.2.0 || >=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "node scripts/build-client.mjs && node --check src/index.js && node --test"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
