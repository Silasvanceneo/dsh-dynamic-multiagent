{
  "name": "dsh-dynamic-multiagent",
  "version": "0.1.0",
  "description": "Dynamic multi-agent orchestration plugin for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core/*": "./src/core/*.js"
  },
  "files": [
    "src",
    "config",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6 <0.2.0 || >=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "node --check src/index.js && node --test"
  },
  "license": "MIT"
}
